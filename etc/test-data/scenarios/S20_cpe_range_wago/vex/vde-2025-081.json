    "lang": "en-GB",
    "notes": [
      {
        "category": "summary",
        "text": "Multiple WAGO devices are affected by CODESYS Control vulnerabilities. The affected WAGO firmware versions are <4.10.0 (FW32) and <4.10.0 (70).\n",
        "title": "Summary"
      },
      {
        "category": "description",
        "text": "Exploitation of these vulnerabilities can cause denial‑of‑service conditions on affected WAGO PLCs and communication components, disrupting industrial control operations. Additionally, opening manipulated CODESYS project files may trigger arbitrary code execution in the user context, compromising system integrity, confidentiality, and availability.",
        "title": "Impact"
      },
      {
        "category": "description",
        "text": "Update to Firmware version 4.10.0 (FW32) or higher. For the latest Custom Firmware please contact the WAGO support.",
        "title": "Remediation"
      }
    ],
    "publisher": {
      "category": "vendor",
      "contact_details": "psirt@wago.com",
