{
  "checkers": [
    {
      "name": "builtin",
      "config": {
        "vulnerabilities": {
          "max_severity": "high",
          "max_score": 9.0,
          "deny": ["CVE-2021-44228"],
          "ignore": [],
          "ignore_unfixed": false
        },
        "licenses": {
          "deny": ["GPL-3.0*", "AGPL-*"],
          "allow": ["MIT", "Apache-2.0", "BSD-*", "ISC", "MPL-2.0"]
        }
      }
    },
    {
      "name": "conforma",
      "config": {
        "mode": "cli",
        "ec_binary": "ec",
        "policy_file": "./my-conforma-policy.yaml",
        "extra_args": []
      }
    }
  ]
}
